{
  "name": "xblocker",
  "version": "1.0.0",
  "private": true,
  "description": "Advanced X.com content filtering and user management extension",
  "license": "MIT",
  "author": "daymade <daymadev89@gmail.com>",
  "repository": "https://github.com/daymade/Twitter-Block-Porn",
  "type": "module",
  "scripts": {
    "qa": "bun --no-env-file tools/qa/run.mjs",
    "qa:check": "bun --no-env-file tools/qa/self-check.mjs",
    "qa:browser": "bun --no-env-file tools/qa/run.mjs browser",
    "qa:smoke": "bun --no-env-file tools/qa/run.mjs smoke",
    "qa:setup": "bun --no-env-file tools/qa/run.mjs setup",
    "qa:doctor": "bun --no-env-file tools/qa/run.mjs doctor",
    "design": "wxt build && playwright test -c tools/design",
    "design:update": "wxt build && playwright test -c tools/design --update-snapshots",
    "design:contrast": "bun --no-env-file tools/design/contrast.mjs",
    "dev": "wxt --port 5555",
    "build": "wxt build",
    "zip": "wxt zip",
    "crx": "bun run scripts/pack-crx.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "typecheck": "bun check --no-script && bun check --no-script -p convex",
    "lint": "bun lint --max-warnings 0",
    "lint:fix": "bun lint --fix",
    "lint:boundaries": "depcruise entrypoints packages convex",
    "format": "oxfmt --write package.json tsconfig.json wxt.config.ts bts.jsonc .oxlintrc.json .oxfmtrc.json bunfig.toml README.md \"entrypoints/**/*.ts\" \"test/**/*.ts\" \"packages/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "oxfmt --check package.json tsconfig.json wxt.config.ts bts.jsonc .oxlintrc.json .oxfmtrc.json bunfig.toml README.md \"entrypoints/**/*.ts\" \"test/**/*.ts\" \"packages/**/*.ts\" \"scripts/**/*.ts\"",
    "check": "bun run typecheck && bun run lint && bun run lint:boundaries && bun run format:check && bun run design:contrast && bun test && bun run build",
    "prepare": "varlock codegen",
    "env:check": "varlock load",
    "env:scan": "varlock scan",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@playwright/test": "1.65.1",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/chrome": "^0.3.4",
    "apca-w3": "^0.1.9",
    "bun-types": "^1.4.2",
    "culori": "^4.0.2",
    "dependency-cruiser": "^18.5.0",
    "happy-dom": "^20.14.6",
    "oxfmt": "^0.72.0",
    "typescript": "next",
    "varlock": "^1.21.1",
    "wxt": "^0.21.4"
  },
  "packageManager": "bun@1.4.0"
}
