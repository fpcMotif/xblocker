# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Your Convex deployment URL, e.g. https://your-app-123.convex.cloud
# @type=url
VITE_CONVEX_URL=

# The Google OAuth client id. Must match GOOGLE_OAUTH_CLIENT_ID set in the Convex
# dashboard (Settings -> Environment Variables).
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Quick block strategy mode: 'inline', 'auto-confirm', or 'off'
VITE_QUICK_BLOCK_MODE=

# Deployment identifier used by Convex CLI
CONVEX_DEPLOYMENT=

# Convex deployment URL
# @type=url
CONVEX_URL=

# Convex site URL
# @type=url
CONVEX_SITE_URL=
